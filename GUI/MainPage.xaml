<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.MainPage">

    
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="New" Clicked="FileMenuNew"/>
            <MenuFlyoutItem Text="Open" Clicked="FileMenuOpenAsync" />
            <MenuFlyoutItem Text="Help" Clicked="FileMenuHelp"/>
        </MenuBarItem>
    </ContentPage.MenuBarItems>
    

    <VerticalStackLayout x:Name="Entire">

        <!-- A Place to put the currently selected cell "namd" and "value" -->
        <Border
            StrokeThickness="2"
            HeightRequest="40">
            <HorizontalStackLayout>
                <Label x:Name="selectedCell" Text="Stuff could go here" WidthRequest="100"/>
            </HorizontalStackLayout>
        </Border>
    
        <!-- the column headers: A, B, C, ... -->
        <Border
            StrokeThickness="2"
            HeightRequest="40">
            <HorizontalStackLayout x:Name="TopLabels"/>
        </Border>
        <!-- the Grid of Spreadsheet GUI Cells -->
        <Border
            StrokeThickness="2"
            HeightRequest="504">
            <ScrollView
                    x:Name="Table"
                    Orientation="Both"
                    HorizontalOptions="FillAndExpand"
                    HorizontalScrollBarVisibility="Always"
                    HeightRequest="500">
            
            <HorizontalStackLayout>
                
                <VerticalStackLayout x:Name="LeftLabels"  BackgroundColor="DarkGray"></VerticalStackLayout>
                <VerticalStackLayout x:Name="Grid"        BackgroundColor="LightGoldenrodYellow"></VerticalStackLayout>
               
            </HorizontalStackLayout>
           
            </ScrollView>
            </Border>
    </VerticalStackLayout>


</ContentPage>
