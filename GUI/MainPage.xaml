<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.MainPage">


    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="New" Clicked="FileMenuNew" />
            <MenuFlyoutItem Text="Open" Clicked="FileMenuOpenAsync" />
            <MenuFlyoutItem Text="Help" Clicked="FileMenuHelp" />
            <MenuFlyoutItem Text="Export" Clicked="FileMenuExport" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>


    <VerticalStackLayout x:Name="Entire">
        <!-- A Place to put the currently selected cell "namd" and "value" -->
        <Border
            x:Name="Border"
            StrokeThickness="2"
            HeightRequest="100">
            <HorizontalStackLayout>
                <Label
                    x:Name="selectedCell"
                    Text="Stuff could go here"
                    WidthRequest="100" />
            </HorizontalStackLayout>
        </Border>

        <!-- the column headers: A, B, C, ... -->
        <HorizontalStackLayout x:Name="TopLabelsParent">
            <ScrollView x:Name="TopLabels"/>
        </HorizontalStackLayout>

        <!-- the Grid of Spreadsheet GUI Cells -->
        <ScrollView
            x:Name="Table"
            Orientation="Both"
            HorizontalScrollBarVisibility="Always">
            <HorizontalStackLayout
                x:Name="Container">
                <VerticalStackLayout>
                    <ScrollView x:Name="LeftLabels"/>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="Grid"/>
            </HorizontalStackLayout>
        </ScrollView>
    </VerticalStackLayout>


</ContentPage>