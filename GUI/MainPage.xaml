<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GUI.MainPage">


    <ContentPage.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="New" Clicked="FileMenuNew" />
            <MenuFlyoutItem Text="Open" Clicked="FileMenuOpenAsync" />
            <MenuFlyoutItem Text="Help" Clicked="FileMenuHelp" />
            <MenuFlyoutItem Text="Export" Clicked="FileMenuExport" />
        </MenuBarItem>
    </ContentPage.MenuBarItems>


    <VerticalStackLayout
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        x:Name="Entire">
        <!-- A Place to put the currently selected cell "namd" and "value" -->
        <Border
            StrokeThickness="2"
            HeightRequest="40">
            <HorizontalStackLayout>
                <Label
                    x:Name="selectedCell"
                    Text="Stuff could go here"
                    WidthRequest="100" />
            </HorizontalStackLayout>
        </Border>

        <!-- the column headers: A, B, C, ... -->
        <HorizontalStackLayout
            x:Name="TopLabels" />

        <!-- the Grid of Spreadsheet GUI Cells -->
        <ScrollView
            x:Name="Table"
            Orientation="Both"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            HorizontalScrollBarVisibility="Always">
            <HorizontalStackLayout
                x:Name="Container">
                <VerticalStackLayout
                    x:Name="LeftLabels" />
                <VerticalStackLayout
                    x:Name="Grid"/>
            </HorizontalStackLayout>
        </ScrollView>
    </VerticalStackLayout>


</ContentPage>